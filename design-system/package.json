{
  "name": "tanaw-design-system",
  "private": true,
  "description": "TANAW's design system: tokens, shared React components, docs and the Storybook preview. Synced into each app as generated copies; neither app depends on this package.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "type": "tsc --noEmit",
    "a11y": "node scripts/a11y-sweep.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.11.0",
    "storybook": "10.6.7",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.4"
  }
}
