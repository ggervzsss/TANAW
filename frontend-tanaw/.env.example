# =============================================================================
# TANAW frontend production build environment template
# Fill these values in the frontend host's build environment.
# =============================================================================

# Public HTTPS URL of the deployed backend API. This is compiled into the
# browser bundle and used to derive REST, WebSocket, and CSP connect targets.
VITE_API_BASE_URL=https://tanaw.onrender.com

# Set this when building for any public static/Docker host that does not
# automatically provide VERCEL=1.
TANAW_PUBLIC_DEPLOYMENT=true

# Deployment validation inputs. Keep these synchronized with the backend
# production environment.
FRONTEND_PUBLIC_URL=https://tanaw-sanpedro.vercel.app
CORS_ORIGINS=https://tanaw-sanpedro.vercel.app
