#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

RANGE="${TANAW_MOCK_RANGE:-6m}"
SCENARIO="${TANAW_MOCK_SCENARIO:-full-workflow}"
TARGET_ENTERPRISE="${TANAW_MOCK_TARGET_ENTERPRISE:-archies_001@tanaw.sanpedro}"

cd "$REPO_ROOT"
exec docker compose exec -e TANAW_ALLOW_MOCK_DATA=true backend \
  uv run mock-data on \
  --range "$RANGE" \
  --scenario "$SCENARIO" \
  --target-enterprise "$TARGET_ENTERPRISE" \
  "$@"
