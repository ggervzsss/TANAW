#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$REPO_ROOT"
docker compose exec backend uv run sample-data off "$@"

for ARG in "$@"; do
  case "$ARG" in -h|--help) exit 0 ;; esac
done
echo "[SUCCESS] mockdata-off: Backend mock data cleared."
