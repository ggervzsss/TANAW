#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

RANGE="${TANAW_MOCK_RANGE:-6m}"
SCENARIO="${TANAW_MOCK_SCENARIO:-full-workflow}"

cd "$REPO_ROOT"
docker compose exec --env "TANAW_MOCK_TARGET_ENTERPRISE=${TANAW_MOCK_TARGET_ENTERPRISE:-}" backend \
  uv run sample-data reset \
  --range "$RANGE" \
  --scenario "$SCENARIO" \
  "$@"

for ARG in "$@"; do
  case "$ARG" in -h|--help) exit 0 ;; esac
done
echo "[SUCCESS] mockdata-reset: Backend mock data replaced."
