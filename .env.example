# =============================================================================
# TANAW Docker Compose development environment
# Copy this file to .env in the repository root before running Docker Compose.
# Never commit the resulting .env file.
# =============================================================================

TANAW_ENV=development

# PostgreSQL container and backend connection
POSTGRES_DB=tanaw_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tanaw_local

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Startup-synchronized accounts. Use unique, strong production values.
DEFAULT_IT_USERNAME=default@email.com
DEFAULT_IT_PASSWORD=default
TEMPORARY_ADMIN_USERNAME=admin@email.com
TEMPORARY_ADMIN_PASSWORD=admin123
TEMPORARY_STAFF_USERNAME=staff@email.com
TEMPORARY_STAFF_PASSWORD=staffstaff
TEMPORARY_IT_USERNAME=it@email.com
TEMPORARY_IT_PASSWORD=it123456

# Browser clients and Compose ports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
VITE_API_BASE_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional backend services
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=TANAW/1.0 local-development
SUPPORT_EMAIL=
TANAW_ALLOW_MOCK_DATA=false

# Email defaults to safe local database logging. To test Resend, switch the
# mode to resend, insert a newly created private API key, and set the one real
# recipient allowed by Resend's development sender.
EMAIL_DELIVERY_MODE=log
RESEND_API_KEY=replace_with_your_resend_api_key
RESEND_WEBHOOK_SECRET=replace_after_registering_the_webhook
EMAIL_FROM_NAME=TANAW
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_REPLY_TO=support@your-resend-receiving-domain.resend.app
EMAIL_INBOUND_ADDRESS=support@your-resend-receiving-domain.resend.app
EMAIL_TEST_RECIPIENT=your-resend-account-email@example.com

# =============================================================================
# Hosting deployment template (Render backend + Vercel frontend)
# Add these values in each hosting provider's environment-variable dashboard.
# These commented values are a guide; do not uncomment production secrets in
# this tracked example file.
# =============================================================================

# Render backend
# TANAW_ENV=production
# DATABASE_URL=<managed-postgresql-connection-url>
# JWT_SECRET_KEY=<new-long-random-production-secret>
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# CORS_ORIGINS=https://tanaw-sanpedro.vercel.app
# DEFAULT_IT_USERNAME=<official-bootstrap-it-email>
# DEFAULT_IT_PASSWORD=<strong-unique-bootstrap-password>
# TEMPORARY_ADMIN_USERNAME=<temporary-admin-email>
# TEMPORARY_ADMIN_PASSWORD=<strong-unique-temporary-password>
# TEMPORARY_STAFF_USERNAME=<temporary-staff-email>
# TEMPORARY_STAFF_PASSWORD=<strong-unique-temporary-password>
# TEMPORARY_IT_USERNAME=<temporary-it-email>
# TEMPORARY_IT_PASSWORD=<strong-unique-temporary-password>
# TANAW_ALLOW_MOCK_DATA=false
# EMAIL_DELIVERY_MODE=resend
# RESEND_API_KEY=<new-private-full-access-resend-key>
# RESEND_WEBHOOK_SECRET=<resend-webhook-signing-secret>
# EMAIL_FROM_NAME=TANAW
# EMAIL_FROM_ADDRESS=no-reply@mail.<verified-lgu-domain>
# EMAIL_REPLY_TO=support@mail.<verified-lgu-domain>
# EMAIL_INBOUND_ADDRESS=support@mail.<verified-lgu-domain>
# Omit EMAIL_TEST_RECIPIENT after a custom sending domain is verified.
# For temporary resend.dev testing only:
# EMAIL_FROM_ADDRESS=onboarding@resend.dev
# EMAIL_TEST_RECIPIENT=<email-used-to-register-with-resend>

# Vercel frontend
# VITE_API_BASE_URL=https://<render-backend-host>
