# =============================================================================
# TANAW Docker Compose development environment
# Copy this file to .env in the repository root before running Docker Compose.
# Never commit the resulting .env file.
# =============================================================================

TANAW_ENV=development

# PostgreSQL container and backend connection
POSTGRES_DB=tanaw_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tanaw_local

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# One-time local bootstrap. Existing accounts are never synchronized or reset.
BOOTSTRAP_IT_USERNAME=default@email.com
BOOTSTRAP_IT_PASSWORD=default

# Optional local demonstration accounts. Production rejects this setting.
TANAW_SEED_DEVELOPMENT_ACCOUNTS=true
DEVELOPMENT_ADMIN_USERNAME=admin@email.com
DEVELOPMENT_ADMIN_PASSWORD=admin123
DEVELOPMENT_STAFF_USERNAME=staff@email.com
DEVELOPMENT_STAFF_PASSWORD=staffstaff
DEVELOPMENT_IT_USERNAME=it@email.com
DEVELOPMENT_IT_PASSWORD=it123456

# Browser clients and Compose ports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
MINIMUM_CLIENT_VERSION=2.0.0
MAXIMUM_CLIENT_MAJOR_EXCLUSIVE=3
CLIENT_CONTRACT_VERSION=2
TARGET_RELEASE_ID=target-cutover-release
TANAW_PUBLIC_DEPLOYMENT=false
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional backend services
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=TANAW/1.0 local-development
TANAW_ALLOW_SIMULATION_DATA=false

# Email defaults to safe local database logging. To test Resend, switch the
# mode to resend, insert a newly created private API key, and set the one real
# recipient allowed by Resend's development sender.
EMAIL_DELIVERY_MODE=log
RESEND_API_KEY=replace_with_your_resend_api_key
EMAIL_FROM_NAME=TANAW
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_TEST_RECIPIENT=your-resend-account-email@example.com
RESEND_API_BASE_URL=https://api.resend.com
EMAIL_REQUEST_TIMEOUT_SECONDS=10
# Optional locally; production requires a separate stable secret of at least 32
# characters. Rotating it invalidates outstanding activation/recovery secrets.
EMAIL_SECRET_DERIVATION_KEY=
EMAIL_OUTBOX_POLL_INTERVAL_SECONDS=1
EMAIL_OUTBOX_LEASE_SECONDS=120
EMAIL_OUTBOX_BATCH_SIZE=5
EMAIL_OUTBOX_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_WINDOW_SECONDS=900
PASSWORD_RESET_PER_IP_LIMIT=10
PASSWORD_RESET_PER_IDENTIFIER_LIMIT=5
PASSWORD_RESET_GLOBAL_LIMIT=200
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_RESPONSE_FLOOR_SECONDS=0.25
ACCOUNT_ACTIVATION_TTL_HOURS=24
ACCOUNT_EMAIL_CHANGE_TTL_HOURS=24
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
RETENTION_CLEANUP_BATCH_SIZE=500
ACTIVATION_TOKEN_RETENTION_DAYS=30
PASSWORD_RESET_RETENTION_DAYS=30
PASSWORD_RESET_RATE_BUCKET_RETENTION_DAYS=2
ACCOUNT_EMAIL_CHANGE_RETENTION_DAYS=180
DEVELOPMENT_DELIVERY_RETENTION_DAYS=7
EMAIL_OUTBOX_RETENTION_DAYS=180
FAILED_EMAIL_OUTBOX_RETENTION_DAYS=365

# =============================================================================
# Hosting deployment template (Render backend + Vercel frontend)
# Add these values in each hosting provider's environment-variable dashboard.
# These commented values are a guide; do not uncomment production secrets in
# this tracked example file.
# =============================================================================

# Render backend
# TANAW_ENV=production
# DATABASE_URL=<managed-postgresql-connection-url>
# JWT_SECRET_KEY=<new-long-random-production-secret>
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# CORS_ORIGINS=https://tanaw-sanpedro.vercel.app
# FRONTEND_PUBLIC_URL=https://tanaw-sanpedro.vercel.app
# MINIMUM_CLIENT_VERSION=2.0.0
# MAXIMUM_CLIENT_MAJOR_EXCLUSIVE=3
# CLIENT_CONTRACT_VERSION=2
# TARGET_RELEASE_ID=<signed-target-release-id>
# TANAW_SEED_DEVELOPMENT_ACCOUNTS=false
# For the first deployment only, when the database has no IT account:
# BOOTSTRAP_IT_USERNAME=<official-bootstrap-it-email>
# BOOTSTRAP_IT_PASSWORD=<unique-bootstrap-password-at-least-12-characters>
# After initialization, these BOOTSTRAP_IT_* values may be removed. TANAW will
# never use them to reset or synchronize the account on later restarts, and the
# database-persisted bootstrap identity remains protected after their removal.
# TANAW_ALLOW_SIMULATION_DATA=false
# EMAIL_DELIVERY_MODE=resend
# RESEND_API_KEY=<new-private-domain-restricted-sending-access-key>
# EMAIL_FROM_NAME=TANAW
# EMAIL_FROM_ADDRESS=no-reply@mail.<verified-lgu-domain>
# RESEND_API_BASE_URL=https://api.resend.com
# EMAIL_REQUEST_TIMEOUT_SECONDS=10
# EMAIL_SECRET_DERIVATION_KEY=<new-separate-random-secret-at-least-32-characters>
# EMAIL_OUTBOX_POLL_INTERVAL_SECONDS=1
# EMAIL_OUTBOX_LEASE_SECONDS=120
# EMAIL_OUTBOX_BATCH_SIZE=5
# EMAIL_OUTBOX_MAX_ATTEMPTS=5
# PASSWORD_RESET_RATE_WINDOW_SECONDS=900
# PASSWORD_RESET_PER_IP_LIMIT=10
# PASSWORD_RESET_PER_IDENTIFIER_LIMIT=5
# PASSWORD_RESET_GLOBAL_LIMIT=200
# PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_RESPONSE_FLOOR_SECONDS=0.25
# ACCOUNT_ACTIVATION_TTL_HOURS=24
# ACCOUNT_EMAIL_CHANGE_TTL_HOURS=24
# RETENTION_CLEANUP_INTERVAL_SECONDS=3600
# RETENTION_CLEANUP_BATCH_SIZE=500
# ACTIVATION_TOKEN_RETENTION_DAYS=30
# PASSWORD_RESET_RETENTION_DAYS=30
# PASSWORD_RESET_RATE_BUCKET_RETENTION_DAYS=2
# ACCOUNT_EMAIL_CHANGE_RETENTION_DAYS=180
# DEVELOPMENT_DELIVERY_RETENTION_DAYS=7
# EMAIL_OUTBOX_RETENTION_DAYS=180
# FAILED_EMAIL_OUTBOX_RETENTION_DAYS=365
# Omit EMAIL_TEST_RECIPIENT after a custom sending domain is verified.
# For temporary resend.dev testing only:
# EMAIL_FROM_ADDRESS=onboarding@resend.dev
# EMAIL_TEST_RECIPIENT=<email-used-to-register-with-resend>

# Vercel frontend
# VITE_API_BASE_URL=https://<render-backend-host>
# Vercel sets its own VERCEL=1 flag, so the build rejects a missing, local, or
# non-HTTPS VITE_API_BASE_URL. For another public static/Docker host, set:
# TANAW_PUBLIC_DEPLOYMENT=true
