# TANAW Docker Compose development environment
# Copy this file to .env in the repository root. Keep .env private.

# CARTO basemap key compiled into the frontend browser bundle.
VITE_CARTO_BASEMAP_API_KEY=

# Geoapify location autocomplete. Keep this server-side key private.
GEOAPIFY_API_KEY=

# Local PostgreSQL. Keep POSTGRES_PASSWORD and DATABASE_URL in sync.
POSTGRES_DB=TanawDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/TanawDB

# Local authentication and one-time account bootstrap.
JWT_SECRET_KEY=change-this-local-development-secret
BOOTSTRAP_IT_USERNAME=default@email.com
BOOTSTRAP_IT_PASSWORD=default

# Optional local demonstration accounts.
TANAW_SEED_DEVELOPMENT_ACCOUNTS=true
DEVELOPMENT_ADMIN_USERNAME=admin@email.com
DEVELOPMENT_ADMIN_PASSWORD=admin123
DEVELOPMENT_STAFF_USERNAME=staff@email.com
DEVELOPMENT_STAFF_PASSWORD=staffstaff
DEVELOPMENT_IT_USERNAME=it@email.com
DEVELOPMENT_IT_PASSWORD=it123456

# Brevo transactional email. Keep log mode while the key is blank. When ready,
# set mode to brevo and replace the sender with one verified in Brevo.
EMAIL_DELIVERY_MODE=log
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
