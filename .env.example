# =============================================================================
# TANAW Docker Compose local development environment
# Copy this file to .env in the repository root before running Docker Compose.
# Never commit the resulting .env file.
# =============================================================================

TANAW_ENV=development

# PostgreSQL container and backend connection
POSTGRES_DB=tanaw_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tanaw_local

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret

# One-time local bootstrap. Existing accounts are never synchronized or reset.
BOOTSTRAP_IT_USERNAME=default@email.com
BOOTSTRAP_IT_PASSWORD=default

# Optional local demonstration accounts.
TANAW_SEED_DEVELOPMENT_ACCOUNTS=true
DEVELOPMENT_ADMIN_USERNAME=admin@email.com
DEVELOPMENT_ADMIN_PASSWORD=admin123
DEVELOPMENT_STAFF_USERNAME=staff@email.com
DEVELOPMENT_STAFF_PASSWORD=staffstaff
DEVELOPMENT_IT_USERNAME=it@email.com
DEVELOPMENT_IT_PASSWORD=it123456

# Browser clients and Compose ports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Local test-data tooling
TANAW_ALLOW_MOCK_DATA=false

# Email defaults to safe local database logging. To test Resend, switch the
# mode to resend, insert a newly created private API key, and set the one real
# recipient allowed by Resend's development sender.
EMAIL_DELIVERY_MODE=log
RESEND_API_KEY=replace_with_your_resend_api_key
EMAIL_FROM_NAME=TANAW
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_TEST_RECIPIENT=your-resend-account-email@example.com
# Optional locally. Set a stable value if you need activation and recovery
# secrets to survive restarts while testing email workflows.
EMAIL_SECRET_DERIVATION_KEY=

# Leave optional tuning unset unless local testing needs non-default behavior.
# The app already has defaults for token lifetimes, retention windows, polling,
# batch sizes, upload limits, geocoding, client compatibility, and telemetry
# cleanup.
