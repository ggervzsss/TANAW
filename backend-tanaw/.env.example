# =============================================================================
# TANAW backend production environment template
# Fill these values in the backend host's secret/environment dashboard.
# Do not copy local development credentials into a production deployment.
# =============================================================================

TANAW_ENV=production

# Database
DATABASE_URL=postgresql+asyncpg://tanaw_user:strong_password@database-host:5432/tanaw_production

# Authentication and client compatibility
JWT_SECRET_KEY=generate-a-unique-64-byte-secret-for-jwt-signing

# Public frontend origin allowed to call the API and receive activation links
CORS_ORIGINS=https://tanaw-sanpedro.vercel.app
FRONTEND_PUBLIC_URL=https://tanaw-sanpedro.vercel.app

# Optional first-run bootstrap for a fresh database with no IT account.
# Leave both blank after the first official IT account exists.
BOOTSTRAP_IT_USERNAME=
BOOTSTRAP_IT_PASSWORD=
TANAW_SEED_DEVELOPMENT_ACCOUNTS=false
TANAW_ALLOW_MOCK_DATA=false

# Outbound transactional email
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=re_live_sending_key_from_resend_dashboard
EMAIL_FROM_NAME=TANAW
EMAIL_FROM_ADDRESS=no-reply@mail.tanaw-sanpedro.ph
EMAIL_SECRET_DERIVATION_KEY=generate-a-different-64-byte-secret-for-email-flows

# Durable storage paths. These must be absolute paths backed by mounted storage.
FINAL_REPORT_ARTIFACT_STORAGE_ROOT=/var/lib/tanaw/final-report-artifacts
ASSET_STORAGE_ROOT=/var/lib/tanaw/assets

# Optional operational tuning such as token lifetime, retention windows,
# polling intervals, batch sizes, upload limits, and telemetry cleanup can be
# left unset unless the deployment needs values different from the application
# defaults.
