TANAW_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/TanawDB
JWT_SECRET_KEY=replace-this-with-a-long-random-secret # [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
BOOTSTRAP_IT_USERNAME=default@email.com
BOOTSTRAP_IT_PASSWORD=default
TANAW_SEED_DEVELOPMENT_ACCOUNTS=true
DEVELOPMENT_ADMIN_USERNAME=admin@email.com
DEVELOPMENT_ADMIN_PASSWORD=admin123
DEVELOPMENT_STAFF_USERNAME=staff@email.com
DEVELOPMENT_STAFF_PASSWORD=staffstaff
DEVELOPMENT_IT_USERNAME=it@email.com
DEVELOPMENT_IT_PASSWORD=it123456
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_PUBLIC_URL=http://localhost:5173

# Outbound transactional email
EMAIL_DELIVERY_MODE=log
RESEND_API_KEY=replace_with_your_resend_api_key
EMAIL_FROM_NAME=TANAW
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_TEST_RECIPIENT=your-resend-account-email@example.com
RESEND_API_BASE_URL=https://api.resend.com
EMAIL_REQUEST_TIMEOUT_SECONDS=10
EMAIL_SECRET_DERIVATION_KEY=
EMAIL_OUTBOX_POLL_INTERVAL_SECONDS=1
EMAIL_OUTBOX_LEASE_SECONDS=120
EMAIL_OUTBOX_BATCH_SIZE=5
EMAIL_OUTBOX_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_WINDOW_SECONDS=900
PASSWORD_RESET_PER_IP_LIMIT=10
PASSWORD_RESET_PER_IDENTIFIER_LIMIT=5
PASSWORD_RESET_GLOBAL_LIMIT=200
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_RESPONSE_FLOOR_SECONDS=0.25
ACCOUNT_ACTIVATION_TTL_HOURS=24

# Render production:
# TANAW_ENV=production
# DATABASE_URL=<managed-postgresql-connection-url>
# JWT_SECRET_KEY=<new-long-random-production-secret>
# CORS_ORIGINS=https://tanaw-sanpedro.vercel.app
# FRONTEND_PUBLIC_URL=https://tanaw-sanpedro.vercel.app
# TANAW_SEED_DEVELOPMENT_ACCOUNTS=false
# For a fresh database only:
# BOOTSTRAP_IT_USERNAME=<official-bootstrap-it-email>
# BOOTSTRAP_IT_PASSWORD=<unique-bootstrap-password-at-least-12-characters>
# After initialization, remove these values; the persisted bootstrap account
# remains protected independently of the current environment.
# EMAIL_DELIVERY_MODE=resend
# RESEND_API_KEY=<new-private-domain-restricted-sending-access-key>
# EMAIL_FROM_NAME=TANAW
# EMAIL_FROM_ADDRESS=no-reply@mail.<verified-lgu-domain>
# RESEND_API_BASE_URL=https://api.resend.com
# EMAIL_REQUEST_TIMEOUT_SECONDS=10
# EMAIL_SECRET_DERIVATION_KEY=<new-separate-random-secret-at-least-32-characters>
# EMAIL_OUTBOX_POLL_INTERVAL_SECONDS=1
# EMAIL_OUTBOX_LEASE_SECONDS=120
# EMAIL_OUTBOX_BATCH_SIZE=5
# EMAIL_OUTBOX_MAX_ATTEMPTS=5
# PASSWORD_RESET_RATE_WINDOW_SECONDS=900
# PASSWORD_RESET_PER_IP_LIMIT=10
# PASSWORD_RESET_PER_IDENTIFIER_LIMIT=5
# PASSWORD_RESET_GLOBAL_LIMIT=200
# PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_RESPONSE_FLOOR_SECONDS=0.25
# ACCOUNT_ACTIVATION_TTL_HOURS=24
# Omit EMAIL_TEST_RECIPIENT after a custom sending domain is verified.
