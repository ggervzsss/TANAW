# TANAW backend production deployment
# Add these values to the hosting provider's secret/environment dashboard.

# Geoapify location autocomplete. Keep this server-side key private.
GEOAPIFY_API_KEY=

TANAW_ENV=production
DATABASE_URL=<managed-postgresql-connection-url>
JWT_SECRET_KEY=<unique-random-secret-at-least-32-characters>

# Public frontend origin used for CORS and links in transactional email.
CORS_ORIGINS=https://tanaw-sanpedro.vercel.app,tanaw-app://desktop
FRONTEND_PUBLIC_URL=https://tanaw-sanpedro.vercel.app

# Required only for the first deployment of an empty database. Remove both
# values after the initial IT account has been created.
BOOTSTRAP_IT_USERNAME=<official-bootstrap-it-email>
BOOTSTRAP_IT_PASSWORD=<unique-bootstrap-password-at-least-12-characters>

# Production transactional email.
EMAIL_DELIVERY_MODE=brevo
BREVO_API_KEY=<private-brevo-api-key>
EMAIL_SECRET_DERIVATION_KEY=<separate-random-secret-at-least-32-characters>
EMAIL_FROM_ADDRESS=<verified-brevo-sender-email>
