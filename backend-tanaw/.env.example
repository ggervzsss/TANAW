# =============================================================================
# TANAW backend production environment template
# Fill these values in the backend host's secret/environment dashboard.
# Do not copy local development credentials into a production deployment.
# =============================================================================

TANAW_ENV=production

# Database
DATABASE_URL=postgresql+asyncpg://tanaw_user:strong_password@database-host:5432/tanaw_production

# Authentication and client compatibility
JWT_SECRET_KEY=generate-a-unique-64-byte-secret-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
MINIMUM_CLIENT_VERSION=2.0.0
MAXIMUM_CLIENT_MAJOR_EXCLUSIVE=3
CLIENT_CONTRACT_VERSION=2
TANAW_RELEASE_ID=tanaw-release-2

# Public frontend origin allowed to call the API and receive activation links
CORS_ORIGINS=https://tanaw-sanpedro.vercel.app
FRONTEND_PUBLIC_URL=https://tanaw-sanpedro.vercel.app

# Optional first-run bootstrap for a fresh database with no IT account.
# Leave both blank after the first official IT account exists.
BOOTSTRAP_IT_USERNAME=
BOOTSTRAP_IT_PASSWORD=
TANAW_SEED_DEVELOPMENT_ACCOUNTS=false
TANAW_ALLOW_SIMULATION_DATA=false

# Geocoding
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=TANAW/1.0-production

# Outbound transactional email
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=re_live_sending_key_from_resend_dashboard
EMAIL_FROM_NAME=TANAW
EMAIL_FROM_ADDRESS=no-reply@mail.tanaw-sanpedro.ph
RESEND_API_BASE_URL=https://api.resend.com
EMAIL_REQUEST_TIMEOUT_SECONDS=10
EMAIL_SECRET_DERIVATION_KEY=generate-a-different-64-byte-secret-for-email-flows
EMAIL_OUTBOX_POLL_INTERVAL_SECONDS=1
EMAIL_OUTBOX_LEASE_SECONDS=120
EMAIL_OUTBOX_BATCH_SIZE=5
EMAIL_OUTBOX_MAX_ATTEMPTS=5

# Password recovery, activation, and email-change controls
PASSWORD_RESET_RATE_WINDOW_SECONDS=900
PASSWORD_RESET_PER_IP_LIMIT=10
PASSWORD_RESET_PER_IDENTIFIER_LIMIT=5
PASSWORD_RESET_GLOBAL_LIMIT=200
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_RESPONSE_FLOOR_SECONDS=0.25
ACCOUNT_ACTIVATION_TTL_HOURS=24
ACCOUNT_EMAIL_CHANGE_TTL_HOURS=24

# Cleanup and retention
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
RETENTION_CLEANUP_BATCH_SIZE=500
ACTIVATION_TOKEN_RETENTION_DAYS=30
PASSWORD_RESET_RETENTION_DAYS=30
PASSWORD_RESET_RATE_BUCKET_RETENTION_DAYS=2
ACCOUNT_EMAIL_CHANGE_RETENTION_DAYS=180
EMAIL_OUTBOX_RETENTION_DAYS=180
FAILED_EMAIL_OUTBOX_RETENTION_DAYS=365
READ_NOTIFICATION_RETENTION_DAYS=180
RESOLVED_ALERT_RETENTION_DAYS=365

# Telemetry retention
TELEMETRY_DOWNSAMPLE_SETTLE_SECONDS=300
TELEMETRY_RAW_OBSERVATION_RETENTION_DAYS=14
TELEMETRY_METRIC_FACT_RETENTION_DAYS=7
TELEMETRY_DEVICE_HEALTH_RETENTION_DAYS=7
TELEMETRY_HOURLY_ROLLUP_RETENTION_DAYS=730

# Durable storage paths. These must be absolute paths backed by mounted storage.
FINAL_REPORT_ARTIFACT_STORAGE_ROOT=/var/lib/tanaw/final-report-artifacts
FINAL_REPORT_ARTIFACT_MAX_BYTES=5242880
FINAL_REPORT_ARTIFACT_POLL_INTERVAL_SECONDS=1
FINAL_REPORT_ARTIFACT_BATCH_SIZE=2
FINAL_REPORT_ARTIFACT_MAX_ATTEMPTS=5
ASSET_STORAGE_ROOT=/var/lib/tanaw/assets
PROFILE_IMAGE_MAX_BYTES=2097152
SUPPORT_ATTACHMENT_MAX_BYTES=5242880
SUPPORT_ATTACHMENT_RETENTION_DAYS=365
ASSET_DELETED_METADATA_RETENTION_DAYS=30
STALE_ASSET_TEMPORARY_RETENTION_HOURS=24
ASSET_ORPHAN_GRACE_HOURS=24
ASSET_ORPHAN_SCAN_MAX_OBJECTS=100000
