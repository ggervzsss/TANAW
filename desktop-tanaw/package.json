{
  "name": "desktop-tanaw",
  "private": true,
  "version": "0.1.0",
  "description": "TANAW Enterprise Desktop application for local enterprise monitoring and reporting.",
  "author": "City Government of San Pedro",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/with-electron-env.cjs vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "contracts:generate": "npm --prefix ../backend-tanaw/scripts/contracts run generate",
    "contracts:check": "npm --prefix ../backend-tanaw/scripts/contracts run check",
    "dist": "node scripts/run-distribution-build.mjs",
    "release:win": "node scripts/run-distribution-build.mjs --require-signing",
    "deployment:validate": "node scripts/validate-deployment-config.ts",
    "renderer:verify": "node scripts/verify-renderer-build.mjs",
    "release:verify": "node scripts/verify-release-package.ts configuration",
    "release:verify:inputs": "node scripts/verify-release-package.ts inputs",
    "release:verify:packaged": "node scripts/verify-release-package.ts packaged",
    "release:checksums": "node scripts/verify-release-package.ts checksums",
    "builder": "electron-builder --win nsis --x64",
    "start": "node scripts/with-electron-env.cjs electron .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && npm run lint:tailwind",
    "lint:tailwind": "node scripts/lint-tailwind-canonical.mjs",
    "lint:tailwind:fix": "node scripts/lint-tailwind-canonical.mjs --fix",
    "local-data": "uv run --directory ml-service python -m app.tools.local_data_cli",
    "models:setup": "uv --cache-dir .uv-cache run --directory ml-service python scripts/setup_detector_models.py",
    "models:setup:openvino": "uv --cache-dir .uv-cache run --directory ml-service python scripts/setup_detector_models.py --export-openvino",
    "models:setup:reid": "uv --cache-dir .uv-cache run --directory ml-service --group export python scripts/export_person_reid_onnx.py --profile all",
    "models:verify": "uv --cache-dir .uv-cache run --directory ml-service python -m scripts.verify_model_assets",
    "ml:bundle": "npm run models:verify && uv --cache-dir .uv-cache run --directory ml-service --group packaging pyinstaller --noconfirm tanaw_ml_service.spec && node scripts/verify-ml-runtime.mjs",
    "preview": "node scripts/with-electron-env.cjs electron .",
    "preview:web": "vite preview",
    "prettier": "prettier --write .",
    "test": "vitest run --exclude=e2e/** --exclude=e2e-electron/**",
    "test:e2e": "playwright test",
    "test:electron": "npm run build && playwright test --config=playwright.electron.config.ts",
    "type": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.16.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/oxide": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.10"
  },
  "main": "dist-electron/main.js"
}
