{
  "include": ["app", "scripts", "tests", "main.py"],
  "exclude": ["**/__pycache__", ".venv", ".pytest_cache", "models"],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none",
  "reportMissingTypeStubs": "none",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": ["."]
    }
  ]
}
